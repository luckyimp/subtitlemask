<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 主遮挡背景条 -->
    <View
        android:id="@+id/viewMaskBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp" />

    <!-- 顶部微型控制栏 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_control_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp">

        <!-- 👁️ 透视原字幕 -->
        <ImageView
            android:id="@+id/btnPeek"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="临时透视字幕"
            android:padding="3dp"
            android:src="@drawable/ic_eye" />

        <!-- 🗕 最小化收起为侧边悬浮球 -->
        <ImageView
            android:id="@+id/btnMinimize"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="收起为悬浮球"
            android:padding="3dp"
            android:src="@drawable/ic_minimize" />

        <View
            android:layout_width="1dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="2dp"
            android:background="#44FFFFFF" />

        <!-- ❌ 关闭服务 -->
        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="关闭遮挡条"
            android:padding="3dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <ImageView
        android:id="@+id/handleResize"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="拖动改变尺寸"
        android:padding="3dp"
        android:src="@drawable/ic_resize" />

</FrameLayout>